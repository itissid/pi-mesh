# Copy OUTSIDE this repository to $MESH_HOST_ROOT/deploy.env; never put secrets here.
# Digest-pinned candidates verified as cached on the parent's NAS; re-verify for your architecture.
NODE_IMAGE=node:24-alpine@sha256:50c8e8ca1d27439048670df5883f32d57cf81cff6233222c893fd0d9884cbd81
TAILSCALE_IMAGE=tailscale/tailscale:v1.104.4@sha256:ed6480b33c6eb67c9cbd203ed42b9fb57e361986725b6856def71b7a3d9e276c
MESH_HOST_ROOT=/mnt/ServiceAndDataPool/projects/.pi-mesh
TS_HOSTNAME=pi-mesh-broker
# Leave empty for sidecar-only enrollment. Set ONLY after reading `tailscale ip -4`.
MESH_TAILSCALE_IPV4=
# Change to unless-stopped only after explicit approval for automatic restart.
MESH_RESTART=no
